# core.autocrlf is on for this machine; without these, git would rewrite line
# endings inside binaries and corrupt them on checkout.
*.pdf  binary
*.mp4  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
